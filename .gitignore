# ======================================
# ZENTIQ PROJECT - GITIGNORE
# ======================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# Jupyter temporary files
.ipynb_checkpoints/

# VS Code
.vscode/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Environment variables and secrets
.env
.env.*
!.env.example

# Streamlit secrets
.streamlit/secrets.toml

# Logs and temporary files
logs/
*.log
*.tmp
*.bak

# Python build files
build/
dist/
*.egg-info/

# Dataset exclusions
datasets/raw/
datasets/processed/
*.xlsx
*.zip

# Ignore model files by default
*.pkl
*.pickle
*.joblib

# Allow required chatbot model files
!models/
!models/zentIQ_tfidf_vectorizer.pkl
!models/zentIQ_logistic_regression_model.pkl

# Ignore temporary exports
*.csv

# Allow selected project documentation
!README.md
!requirements.txt